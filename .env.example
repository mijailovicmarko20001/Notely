# Copy to .env and fill in. Never commit .env.

# --- Stage 0: fetch ---
# Browser to pull YouTube auth cookies from, only needed if videos are
# private (not just unlisted): chrome | firefox | safari | edge
YOUTUBE_COOKIES_BROWSER=chrome

# --- Stage 1: transcription ---
# faster-whisper / mlx-whisper model size: tiny | base | small | medium |
# large-v3 | large-v3-turbo. large-v3-turbo is the benchmarked pick for
# this course (see DOCUMENTATION.md §3) — start smaller if you haven't
# validated quality/speed on your own recordings yet.
WHISPER_MODEL=small
# Force a language (ISO 639-1, e.g. "sr", "en") instead of auto-detect.
# Auto-detect only samples the first ~30s and can misfire on short/noisy
# clips — pin this once you know the lecture's language. Leave unset to
# auto-detect.
# WHISPER_LANGUAGE=
# Transcription backend: faster-whisper (default, any CPU) | mlx (Apple
# Silicon GPU only, ~4x faster — requires mlx-whisper, see requirements.txt)
# | groq (cloud, Groq-hosted Whisper API — sends lecture audio to Groq;
# opt-in only, mainly useful on machines without a usable local GPU; needs
# GROQ_API_KEY below; see 01_transcribe.py::transcribe_with_groq for the
# verification status — the request/response parsing was checked against
# the installed SDK, but not a live account)
WHISPER_BACKEND=faster-whisper
# MLX-converted model repo, only read when WHISPER_BACKEND=mlx. Defaults to
# mlx-community/whisper-<WHISPER_MODEL> if unset.
# WHISPER_MLX_REPO=
# Groq API key, only read when WHISPER_BACKEND=groq. Get one at
# https://console.groq.com/keys
# GROQ_API_KEY=
# Groq's own model naming (NOT the same values as WHISPER_MODEL above —
# "whisper-large-v3" or "whisper-large-v3-turbo"), only read when
# WHISPER_BACKEND=groq.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# CPU-backend tuning (faster-whisper only; ignored under mlx). Defaults
# (auto compute type, 4 threads) were the fastest combination benchmarked
# on Apple Silicon — only override if you've measured otherwise on yours.
# WHISPER_COMPUTE=auto
# WHISPER_CPU_THREADS=4

# --- Stage 4: frame-to-slide matching ---
# tesseract language(s) for OCR-ing captured frames, matching your slides'
# language. Needs the matching tesseract traineddata installed.
OCR_LANG=eng

# --- Stage 6: note generation ---
ANTHROPIC_API_KEY=sk-ant-...
# Claude model for note generation
NOTES_MODEL=claude-sonnet-5
# Concurrent per-slide API calls
# NOTES_CONCURRENCY=4
# Embed each slide's rendered PNG in its note (1) or skip images (0)
# NOTES_EMBED_IMAGES=1
# Send the actual on-screen video frame for each slide to Claude (vision),
# not just the clean deck render's extracted text -- catches anything the
# professor wrote/drew live on the slide, which the deck file never had.
# Off by default: a real added cost (vision tokens on every slide call),
# not a free win. Also embeds that frame in the note markdown (alongside
# the clean deck image) when on, so a human reader can see it too. See
# DOCUMENTATION.md for the full feature.
# NOTES_SEND_FRAME_IMAGE=0
# Confirm/caption worked-example frames flagged by stage 4/5's heuristics
# (whiteboard switches, live annotation over a slide, a deck's own example
# slide) and embed them in the note markdown. Off by default: a real added
# cost (one vision call per candidate frame). See DOCUMENTATION.md for the
# full feature.
# NOTES_DETECT_EXAMPLES=0
# Claude model for example confirmation -- a cheap classify-and-caption
# task, so this defaults to Haiku rather than NOTES_MODEL.
# NOTES_EXAMPLES_MODEL=claude-haiku-4-5
# Max example candidates confirmed per lecture (cost ceiling).
# NOTES_EXAMPLES_MAX=40
