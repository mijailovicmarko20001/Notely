# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Browser to pull YouTube auth cookies from, only needed if videos are
# private (not just unlisted): chrome | firefox | safari | edge
YOUTUBE_COOKIES_BROWSER=chrome
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Claude model for note generation
NOTES_MODEL=claude-sonnet-5
